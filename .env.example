# ============================================================================
# CONFIGURAÇÃO DE AMBIENTE - CORREÇÃO DE PROVAS & GABARITOS OMR
# ============================================================================

# Porta do Servidor (Padrão: 8080)
PORT=8080
HOST=0.0.0.0

# ----------------------------------------------------------------------------
# BANCO DE DADOS
# ----------------------------------------------------------------------------
# 1. Modo SQLite Local (Padrão para desenvolvimento):
# Deixe DATABASE_URL vazio ou não configure para usar automaticamente backend/storage/exams.db.
# DATABASE_URL=

# 2. Modo PostgreSQL (Produção na VPS):
# Configure a URL de conexão do PostgreSQL instalado na sua VPS.
# Exemplo isolado do i-Educar:
DATABASE_URL=postgresql://correcao_user:SUA_SENHA_SEGURA@localhost:5432/correcao_provas

# ----------------------------------------------------------------------------
# SEGURANÇA E SESSÃO
# ----------------------------------------------------------------------------
SECRET_KEY=sua_chave_secreta_super_segura_aqui_gerar_uma_nova_para_producao

# ----------------------------------------------------------------------------
# INTELIGÊNCIA ARTIFICIAL - GERADOR DE QUESTÕES BNCC (GROQ CLOUD)
# ----------------------------------------------------------------------------
# Chave de API gratuita da Groq (Modelo: Llama 3.1 8B Instant).
# Pode ser configurada aqui no .env ou diretamente pela interface no painel "Configurações".
# Obtenha sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_da_groq_aqui
